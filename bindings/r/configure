#!/bin/sh
# Resolve the prebuilt liblinkrs location and generate src/Makevars.
# LINKRS_LIB may name the library file explicitly; otherwise the workspace
# target/debug and target/release outputs next to this checkout are used.
set -eu

pkg_dir=$(dirname "$0")
root=$(cd "$pkg_dir/../.." && pwd)

lib_file=${LINKRS_LIB:-}
if [ -z "$lib_file" ]; then
  for profile in debug release; do
    for name in liblinkrs.so liblinkrs.dylib linkrs.dll; do
      candidate="$root/target/$profile/$name"
      if [ -f "$candidate" ]; then
        lib_file=$candidate
        break 2
      fi
    done
  done
fi

if [ -z "$lib_file" ] || [ ! -f "$lib_file" ]; then
  echo "configure: liblinkrs not found; set LINKRS_LIB or run cargo build --features c_api first." >&2
  exit 1
fi

lib_dir=$(dirname "$lib_file")

sed -e "s|@LINKRS_INCLUDE@|$root/include|g" \
    -e "s|@LINKRS_LIBDIR@|$lib_dir|g" \
    "$pkg_dir/src/Makevars.in" > "$pkg_dir/src/Makevars"

echo "configure: using liblinkrs at $lib_file"
