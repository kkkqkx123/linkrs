-- Vector Search E2E Test Data
-- Generated: 2026-04-28T12:18:48.942008

-- Create test space
CREATE SPACE IF NOT EXISTS e2e_vector (vid_type=STRING)
USE e2e_vector

-- Create tags
CREATE TAG IF NOT EXISTS product_vector(
    product_id: STRING NOT NULL,
    name: STRING,
    category: STRING,
    embedding: VECTOR(128),
    price: DOUBLE,
    tags: LIST<STRING>
)

CREATE TAG IF NOT EXISTS image_vector(
    image_id: STRING NOT NULL,
    url: STRING,
    feature: VECTOR(512),
    labels: LIST<STRING>
)

CREATE TAG IF NOT EXISTS text_embedding(
    doc_id: STRING NOT NULL,
    content: STRING,
    embedding: VECTOR(768),
    category: STRING
)

