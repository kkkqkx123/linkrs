+                linkrs_txn_rollback(txn),
+                linkrs_error_code_t::LINKRS_OK as c_int
+            );
+            linkrs_txn_free(txn);
+            linkrs_session_close(session);
+            assert_eq!(linkrs_close(db), 0);
+        }
+    }
 }
