+unsafe fn take_c_string(ptr: *mut std::ffi::c_char) -> Option<String> {
+    if ptr.is_null() {
+        return None;
+    }
+    let text = std::ffi::CStr::from_ptr(ptr)
+        .to_str()
+        .ok()
+        .map(|value| value.to_string());
+    linkrs::api::embedded::c_api::database::linkrs_free_string(ptr);
+    text
+}
