diff --git a/crates/linkrs-storage/src/schema/version_history.rs b/crates/linkrs-storage/src/schema/version_history.rs
index 0e909c7..b915431 100644
--- a/crates/linkrs-storage/src/schema/version_history.rs
+++ b/crates/linkrs-storage/src/schema/version_history.rs
@@ -44,6 +44,55 @@ impl LabelVersionHistory {
     pub fn get_versions(&self) -> Vec<u64> {
         self.change_log.get_versions()
     }
+
+    /// Render the history as the JSON object used by the schema version API.
+    ///
+    /// Both the HTTP handler and the embedded API call this projection so a
+    /// label's history has one serialized shape across transports.
+    pub fn summary_json(&self, space: &str, is_edge: bool) -> serde_json::Value {
+        let versions = self
+            .change_log
+            .get_versions()
+            .iter()
+            .map(|&version| {
+                let version_changes = self
+                    .change_log
+                    .get_version_changes(version)
+                    .cloned()
+                    .unwrap_or_default();
+                let timestamp_ms = version_changes
+                    .iter()
+                    .map(|c| c.timestamp_ms)
+                    .max()
+                    .unwrap_or(0);
+                let changes: Vec<serde_json::Value> = version_changes
+                    .into_iter()
+                    .map(|change| {
+                        serde_json::json!({
+                            "change_type": format!("{:?}", change.details),
+                            "description": change.details.description(),
+                            "details": {
+                                "description": change.details.description(),
+                            },
+                        })
+                    })
+                    .collect();
+
+                serde_json::json!({
+                    "version": version,
+                    "timestamp_ms": timestamp_ms,
+                    "changes": changes,
+                })
+            })
+            .collect::<Vec<_>>();
+
+        serde_json::json!({
+            "space": space,
+            "label": self.label_name,
+            "is_edge": is_edge,
+            "versions": versions,
+        })
+    }
 }
 
