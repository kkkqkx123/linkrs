@@ -0,0 +1,96 @@
+//! Fulltext search services shared by both transports.
+
+use linkrs_fulltext::SearchResult;
+
+use crate::http::error::HttpError;
+use crate::http::state::AppState;
+use crate::services::authz::require_space_read;
+use crate::storage::{
+    StorageClient, StorageOperationContextOps, StorageSchemaContextOps, StorageSyncContextOps,
+};
+
+fn default_limit() -> usize {
+    10
+}
+
+/// Fulltext search request body.
+#[derive(Debug, serde::Deserialize, utoipa::ToSchema)]
+pub struct FulltextSearchRequestBody {
+    pub space_id: u64,
+    pub tag_name: String,
+    pub field_name: String,
+    pub query: String,
+    #[serde(default = "default_limit")]
+    pub limit: usize,
+}
+
+/// Fulltext search response body.
+#[derive(Debug, serde::Serialize, utoipa::ToSchema)]
+pub struct FulltextSearchResponse {
+    pub results: Vec<FulltextSearchHit>,
+    pub total_hits: usize,
+}
+
+/// One fulltext search hit.
+#[derive(Debug, serde::Serialize, utoipa::ToSchema)]
+pub struct FulltextSearchHit {
+    pub doc_id: String,
+    pub score: f32,
+    #[serde(default)]
+    pub highlights: Option<Vec<String>>,
+}
+
+/// Search a fulltext index.
+pub(crate) async fn search_core<
+    S: StorageClient
+        + StorageSchemaContextOps
+        + StorageSyncContextOps
+        + StorageOperationContextOps
+        + Clone
+        + Send
+        + Sync
+        + 'static,
+>(
+    state: &AppState<S>,
+    session_id: i64,
+    request: FulltextSearchRequestBody,
+) -> Result<FulltextSearchResponse, HttpError> {
+    require_space_read(state, session_id, request.space_id as i64)?;
+    let graph_service = state.server.get_graph_service();
+    let fulltext_api = graph_service.fulltext_api();
+
+    let fulltext_api = fulltext_api
+        .ok_or_else(|| HttpError::InternalError("Fulltext API is not available".to_string()))?;
+
+    let results = fulltext_api
+        .search(
+            request.space_id,
+            &request.tag_name,
+            &request.field_name,
+            &request.query,
+            request.limit,
+        )
+        .await
+        .map_err(|e| HttpError::InternalError(e.to_string()))?;
+
+    let total_hits = results.len();
+    let hits: Vec<FulltextSearchHit> = results
+        .into_iter()
+        .map(|r: SearchResult| {
+            let doc_id = r
+                .doc_id
+                .to_string()
+                .map_err(|e| HttpError::InternalError(e))?;
+            Ok(FulltextSearchHit {
+                doc_id,
+                score: r.score,
+                highlights: r.highlights,
+            })
+        })
+        .collect::<Result<Vec<_>, HttpError>>()?;
+
+    Ok(FulltextSearchResponse {
+        results: hits,
+        total_hits,
+    })
+}
diff --git a/crates/linkrs-server/src/services/function.rs b/crates/linkrs-server/src/services/function.rs
new file mode 100644
index 0000000..bbe8a6a
--- /dev/null
+++ b/crates/linkrs-server/src/services/function.rs
@@ -0,0 +1,106 @@
+//! Transport-neutral custom function registry mutation helpers.
+
+use parking_lot::RwLock;
+
+use crate::http::error::HttpError;
+use crate::query::executor::expression::functions::{FunctionRegistry, UdfError};
+
+/// Transport-neutral function registry mutation failure.
+#[derive(Debug)]
+pub(crate) enum FunctionOpError {
+    NotFound(String),
+    Conflict(String),
+    Invalid(String),
+    Failed(String),
+}
+
+pub(crate) fn udf_error_to_op(error: UdfError) -> FunctionOpError {
+    let message = error.to_string();
+    match error {
+        UdfError::InvalidPath(_, _) | UdfError::InvalidName(_) => FunctionOpError::Invalid(message),
+        UdfError::AlreadyLoaded(_, _) | UdfError::BuiltinConflict(_) => {
+            FunctionOpError::Conflict(message)
+        }
+        UdfError::NotLoaded(_) => FunctionOpError::NotFound(message),
+        _ => FunctionOpError::Failed(message),
+    }
+}
+
+/// Register the UDF library at `implementation` (a local dynamic-library
+/// path) under `name`. Returns the registered (library-provided) name.
+///
+/// Only library-backed implementations can execute, so registration goes
+/// through the dynamic UDF loader: metadata-only registrations would
+/// produce functions that can never run.
+pub(crate) fn register_udf_from_source(
+    registry: &RwLock<FunctionRegistry>,
+    name: &str,
+    implementation: &str,
+) -> Result<String, FunctionOpError> {
+    if name.trim().is_empty() {
+        return Err(FunctionOpError::Invalid(
+            "function name must not be empty".to_string(),
+        ));
+    }
+    if registry.read().contains(name) {
+        return Err(FunctionOpError::Conflict(format!(
+            "function '{name}' already exists"
+        )));
+    }
+    if implementation.trim().is_empty() {
+        return Err(FunctionOpError::Invalid(
+            "implementation must be a local UDF library path; remote sources and embedded code are not supported".to_string(),
+        ));
+    }
+    let mut guard = registry.write();
+    match guard.install_dynamic_udf(implementation) {
+        Ok(loaded_name) => {
+            if loaded_name.to_uppercase() != name.to_uppercase() {
+                let _ = guard.unload_dynamic_udf(&loaded_name);
+                Err(FunctionOpError::Invalid(format!(
+                    "library exports '{loaded_name}', which does not match requested '{name}'"
+                )))
+            } else {
+                Ok(loaded_name)
+            }
+        }
+        Err(e) => Err(udf_error_to_op(e)),
+    }
+}
+
+/// Unload a dynamic UDF or remove a custom function by name.
+pub(crate) fn unregister_udf_by_name(
+    registry: &RwLock<FunctionRegistry>,
+    name: &str,
+) -> Result<(), FunctionOpError> {
+    if !registry.read().contains(name) {
+        return Err(FunctionOpError::NotFound(format!(
+            "function '{name}' does not exist"
+        )));
+    }
+    if registry.read().get_builtin(name).is_some() {
+        return Err(FunctionOpError::Invalid(format!(
+            "built-in function '{name}' cannot be unregistered"
+        )));
+    }
+    let mut guard = registry.write();
+    if guard.is_dynamic(name) {
+        guard.unload_dynamic_udf(name).map_err(udf_error_to_op)
+    } else if guard.unregister_custom(name) {
+        Ok(())
+    } else {
+        Err(FunctionOpError::NotFound(format!(
+            "function '{name}' does not exist"
+        )))
+    }
+}
+
+pub(crate) fn op_error_to_http(error: FunctionOpError) -> HttpError {
+    match error {
+        FunctionOpError::NotFound(message) => HttpError::not_found(message),
+        FunctionOpError::Conflict(message) | FunctionOpError::Invalid(message) => {
+            HttpError::bad_request(message)
+        }
+        FunctionOpError::Failed(message) => HttpError::internal(message),
+    }
+}
diff --git a/crates/linkrs-server/src/services/migration_progress.rs b/crates/linkrs-server/src/services/migration_progress.rs
new file mode 100644
index 0000000..6c3e4f5
--- /dev/null
+++ b/crates/linkrs-server/src/services/migration_progress.rs
@@ -0,0 +1,54 @@
+//! Migration progress fan-out shared by the SSE endpoint and gRPC stream.
+
+use std::collections::HashMap;
+use std::sync::{Arc, RwLock};
+
+use linkrs_migration::MigrationEvent;
+
+type Sender = tokio::sync::broadcast::Sender<MigrationEvent>;
+type Receiver = tokio::sync::broadcast::Receiver<MigrationEvent>;
+
+static HUB: std::sync::OnceLock<Arc<RwLock<HashMap<String, Sender>>>> = std::sync::OnceLock::new();
+
+fn hub() -> Arc<RwLock<HashMap<String, Sender>>> {
+    HUB.get_or_init(|| Arc::new(RwLock::new(HashMap::new())))
+        .clone()
+}
+
+fn hub_key(space: &str, label: &str, is_edge: bool) -> String {
+    format!("{}/{}/{}", space, label, is_edge)
+}
+
+pub(crate) fn get_or_create_sender(space: &str, label: &str, is_edge: bool) -> Sender {
+    let key = hub_key(space, label, is_edge);
+    let hub_arc = hub();
+    {
+        let read = hub_arc
+            .read()
+            .expect("migration progress hub lock poisoned");
+        if let Some(s) = read.get(&key) {
+            return s.clone();
+        }
+    }
+    let mut write = hub_arc
+        .write()
+        .expect("migration progress hub lock poisoned");
+    if let Some(s) = write.get(&key) {
+        return s.clone();
+    }
+    let (tx, _rx) = tokio::sync::broadcast::channel(100);
+    write.insert(key, tx.clone());
+    tx
+}
+
+pub(crate) fn subscribe(space: &str, label: &str, is_edge: bool) -> Receiver {
+    get_or_create_sender(space, label, is_edge).subscribe()
+}
+
+/// Adapt a broadcast sender into an `EventSubscriptions` callback so a
+/// running migration fans its lifecycle events out to subscribers.
+pub(crate) fn event_bridge(sender: Sender) -> Arc<dyn Fn(&MigrationEvent) + Send + Sync> {
+    Arc::new(move |event: &MigrationEvent| {
+        let _ = sender.send(event.clone());
+    })
+}
