+fn parse_value<T>(key_desc: &str, value: &serde_json::Value) -> Result<T, String>
+where
+    T: for<'de> serde::Deserialize<'de>,
+{
+    serde_json::from_value(value.clone())
+        .map_err(|e| format!("invalid value for '{key_desc}': {e}"))
+}
