{
	"name": "graphdb-studio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:mock": "vite dev --mode mock",
		"build": "vite build",
		"build:mock": "vite build --mode mock",
		"preview": "vite preview",
		"check": "npm run check:i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:i18n": "node scripts/check-i18n.mjs",
		"test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"gen:api": "npm run gen --prefix ../tools/openapi-codegen"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.25.4",
		"@inlang/paraglide-vite": "^1.4.0",
		"@inlang/plugin-message-format": "^4.4.4",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/json-bigint": "^1.0.4",
		"@types/node": "^24.13.3",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.2.1"
	},
	"dependencies": {
		"cytoscape": "^3.34.0",
		"json-bigint": "^1.0.0",
		"monaco-editor": "^0.57.0",
		"openapi-fetch": "^0.17.0"
	}
}
