+            .map_err(status_error)
+    }
+
+    /// Execute a query and stream result chunks.
+    ///
+    /// Returns the raw server stream: consume it with `tonic::Streaming::message`
+    /// until it yields `Ok(None)`.
+    pub async fn execute_query_stream(
+        &self,
