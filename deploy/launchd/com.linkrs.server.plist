<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.linkrs.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/linkrs-server</string>
        <string>serve</string>
        <string>--config</string>
        <string>/usr/local/etc/linkrs/config.toml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/usr/local/var/lib/linkrs</string>
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/linkrs/service-out.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/linkrs/service-err.log</string>
</dict>
</plist>
