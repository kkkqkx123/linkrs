#!/bin/sh
set -e

systemctl daemon-reload >/dev/null 2>&1 || true

# Enable only according to the distribution preset; never start in chroot/build.
if [ -z "${DPKG_MAINTSCRIPT_PACKAGE:-}" ] || [ -z "${DPKG_RUNNING_VERSION:-}" ]; then
    :
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl preset linkrs.service >/dev/null 2>&1 || true
fi
