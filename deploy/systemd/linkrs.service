[Unit]
Description=Linkrs graph database server
Documentation=https://github.com/linkrs/linkrs
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify: systemd waits for READY=1, which the server sends after its
# listeners are bound, and tracks STOPPING=1 during graceful shutdown.
Type=notify
NotifyAccess=main
User=linkrs
Group=linkrs
WorkingDirectory=/var/lib/linkrs
Environment=LINKRS_CONFIG=/etc/linkrs/config.toml
ExecStart=/usr/bin/linkrs-server serve --config /etc/linkrs/config.toml
# No ExecReload: the server does not handle SIGHUP, so reload would kill
# the process. Use `systemctl restart linkrs` until HUP reload is implemented.
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=linkrs

[Install]
WantedBy=multi-user.target
